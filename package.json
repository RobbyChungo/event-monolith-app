{
  "name": "event-monolith-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy && prisma generate",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smokeTest.js",
    "test": "vitest"
  },
  "dependencies": {
    "@elysiajs/swagger": "^0.8.0",
    "@google/genai": "^1.27.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.9.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "elysia": "^0.8.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "openai": "^6.7.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.5.1",
    "@types/nodemailer": "^6.4.21",
    "prisma": "^5.9.0",
    "testcontainers": "^9.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.5.6"
  }
}
