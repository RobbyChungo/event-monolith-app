generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// === ENUMS ===
//
enum UserRole {
  ADMIN
  ORGANIZER
  ATTENDEE
}

enum RSVPStatus {
  YES
  NO
  MAYBE
}

//
// === MODELS ===
//
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  verified  Boolean   @default(false)
  role      UserRole  @default(ATTENDEE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  events    Event[]   @relation("UserEvents")
  rsvps     RSVP[]
  profile   UserProfile?
}

model Event {
  id            String         @id @default(uuid())
  title         String
  description   String?
  date          DateTime
  location      String
  createdAt     DateTime       @default(now())

  createdById   String
  createdBy     User           @relation("UserEvents", fields: [createdById], references: [id])

  notifications Notification[]
  rsvps         RSVP[]
  embedding     EventEmbedding?
}

model Notification {
  id        String    @id @default(uuid())
  message   String
  eventId   String
  createdAt DateTime  @default(now())

  event     Event     @relation(fields: [eventId], references: [id])
}

model RSVP {
  id        String      @id @default(uuid())
  userId    String
  eventId   String
  response  RSVPStatus  // ✅ Changed from String → RSVPStatus enum
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id])
  event     Event       @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

//
// === AI/Personalization Models ===
//
model EventEmbedding {
  id        String   @id @default(uuid())
  eventId   String   @unique
  vector    Json     // store embedding as JSON array
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id])
}

model UserProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  embedding  Json?
  interests  Json?
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
}
